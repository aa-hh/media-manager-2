                {
                  "type": "text",
                  "id": "XAfJA",
                  "name": "Notes body",
                  "fill": "$b:muted-foreground",
                  "textGrowth": "fixed-width",
                  "width": 720,
                  "content": "Each row gets the layout that fits what it holds. Trending is the big row: five large posters with genres, mixed movies and TV, and an All / Movies / TV switch. Popular is a dense shelf of seven, numbered by rank, so the order is the point. Upcoming movies sit under year markers, because the server only knows the year. Upcoming TV is a timeline with the real premiere date, weekday and a countdown. The service row sits in its own panel, named for the service.\nServer needs: genres per title and the exact premiere date in the list response (today it sends title, type, year, poster, backdrop, rating, overview, library status). Weekday and countdown are worked out in the browser from the date.",
                  "lineHeight": 1.5,
                  "fontFamily": "$b:font-ui",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
