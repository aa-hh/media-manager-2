              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "E4TSV",
              "name": "Section note",
              "fill": "$muted-foreground",
              "textGrowth": "fixed-width",
              "width": 900,
              "content": "One search result, 84 px: enough to tell titles apart before opening one. Poster 40 by 60 in colour, Title and Year, Meta as one plain line (TV or Movie, network or studio, Continuing or Ended, rating), Overview on one line, and In library at the right with the file count. Overrides: Poster fill, Title, Year, Meta, Overview, Status (badge strong, off when not in library), Files (fixed 80 px column, right aligned, so every In library badge lines up whatever the count), Add (outline v2/Button at the 28 px row size from control-h-row, control-px-row and control-text-row, on when not in library). Status is the plain badge (check and words, no box) at 28 px, so In library lines up with Add without looking like a button. States: default, hover, pressed, focus (inner ring, radius 8), highlighted by keyboard (same as hover). Maps to shadcn Command item laid out as a row.",
              "lineHeight": 1.45,
              "fontFamily": "$font-ui",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "PwZi2",
              "name": "Demo column",
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "frame",
                  "id": "A6Gr4m",
                  "name": "State Component",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
