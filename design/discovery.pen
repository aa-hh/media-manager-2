              "type": "text",
              "id": "ZnvgV",
              "name": "Note",
              "fill": "$b:muted-foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Previous and Next move by the number of fully visible cards and fade out at either end.",
              "lineHeight": 1.5,
              "fontFamily": "$b:font-ui",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "vtsFZ",
              "name": "Note",
              "fill": "$b:muted-foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Tab moves through the cards and scrolls the focused one into view. Coming Back to Discover restores each row's scroll position.",
