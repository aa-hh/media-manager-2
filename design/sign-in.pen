                      ]
                    },
                    {
                      "type": "frame",
                      "id": "aReyH",
                      "name": "Notes",
                      "width": 640,
                      "layout": "vertical",
                      "gap": 12,
                      "children": [
                        {
                          "type": "text",
                          "id": "gz2qD",
                          "name": "Notes heading",
                          "fill": "#1A1400",
                          "content": "Notes",
                          "fontFamily": "Schibsted Grotesk",
                          "fontSize": 20,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "iem5C",
                          "name": "Notes body",
                          "fill": "#1A1A1A",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "About 30,000 points drift through a curl-noise field: a smooth random pattern whose swirl gives a flow that never bunches up or thins out. Each point leaves a trail that fades a little every frame, so the paths build into silk.\n\nThe main current runs left to right at about 34 px a second and parts around the sign-in, which sits in still water. The swirls reshape over roughly 25 seconds.\n\nChecking: the current bends into one slow spiral that drains toward the button; old trails clear faster and the amber threads brighten. Refused: the flow reverses and threads are flung outward from the sign-in, then settle within about 4 seconds.\n\nPalette: ink #07090C, silver-blue #B2C7DB, Plex amber #E5A00D (2% of threads, plus the button). Font: Söhne Mono for the wordmark, Söhne for copy.\n\nCost: about 4.5 ms a frame on one CPU core at half resolution, so 60 fps.\n\nNext: let the cursor stir the field.",
                          "lineHeight": 1.5,
                          "fontFamily": "Schibsted Grotesk",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
