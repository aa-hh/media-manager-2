              "type": "text",
              "id": "EpTJP",
              "name": "Note",
              "fill": "$b:muted-foreground",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The strip runs to both window edges, so posters slide under them while scrolling. At rest, the first card lines up with the 40 px page margin.",
