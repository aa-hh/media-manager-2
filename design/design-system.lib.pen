            {
              "type": "text",
              "id": "w2c595",
              "name": "Sheet note",
              "fill": "$muted-foreground",
              "textGrowth": "fixed-width",
              "width": 900,
              "content": "Light mode. Colour and type from direction 3 (paper white, black actions, lime only for the best release and live downloads). Corners and shadows from direction 1: 4 to 10 px, shadows only on things that float. Density from direction 2: 40 px rows, 40 px page margin. Every v2/ component shows its states as instances beside it. Focus is always a 2 px ring with a 2 px white gap (v2/Focus ring).",
              "lineHeight": 1.5,
              "fontFamily": "$font-ui",
              "fontSize": 14,
              "fontWeight": "normal"
            }
