                    },
                    {
                      "type": "frame",
                      "id": "TgEiG",
                      "name": "Notes",
                      "width": 640,
                      "layout": "vertical",
                      "gap": 14,
                      "children": [
                        {
                          "type": "text",
                          "id": "pZWsC",
                          "name": "Note 1",
                          "fill": "#1A1400",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Every pixel samples three layers of smooth random noise: a sky of sideways cloud bands above a wavy horizon, and a ripple plane below it that squeezes toward the horizon like water in perspective. Brightness falls off with distance from the horizon, then an 8x8 ordered dither snaps each pixel to one of five inks, with fixed ink and paper specks on top so it reads as print.",
                          "lineHeight": 1.45,
                          "fontFamily": "Schibsted Grotesk",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "zbCj0",
                          "name": "Note 2",
                          "fill": "#1A1400",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Motion: clouds drift sideways about 40 px a second; the three middle inks swap places once a minute.",
                          "lineHeight": 1.45,
                          "fontFamily": "Schibsted Grotesk",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "EzCAE",
                          "name": "Note 3",
                          "fill": "#1A1400",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Checking: the field brightens and darkens every 2.6 s, so the dot density breathes. Refused: drift stops within a second and the inks drop to two, ink and rust.",
                          "lineHeight": 1.45,
                          "fontFamily": "Schibsted Grotesk",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "YCiTE",
                          "name": "Note 4",
                          "fill": "#1A1400",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Palette: #12140F, #1F4A43, #8A341E, #4B3A6B, #D9A02A, #EFE3C8, rust #B4482B. Font: IBM Plex Mono.",
                          "lineHeight": 1.45,
                          "fontFamily": "Schibsted Grotesk",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "kR8BU",
                          "name": "Note 5",
                          "fill": "#1A1400",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Cost: drawn at half resolution, about 15.5 ms a frame at 1440x900, so roughly 60 fps. Next: move the pixel loop into a WebGL shader to free the main thread.",
                          "lineHeight": 1.45,
                          "fontFamily": "Schibsted Grotesk",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
