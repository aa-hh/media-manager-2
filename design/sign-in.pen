                        {
                          "type": "text",
                          "id": "iilIw",
                          "name": "Phone idle t2 caption",
                          "fill": "#1A1400",
                          "textGrowth": "fixed-width",
                          "width": 300,
                          "content": "Phone, idle, 2 s",
                          "fontFamily": "Schibsted Grotesk",
